#!/bin/sh
set -e

msg_file=$1
subject=$(sed -n '1p' "$msg_file" | tr -d '\r')

case "$subject" in
Merge\ * | Revert\ * | fixup!* | squash!*)
	exit 0
	;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|wip)(\([a-zA-Z0-9/_-]+\))?(!)?: .+'; then
	echo "提交说明需符合 Conventional Commits，且描述使用简体中文，例如："
	echo "  feat(desktop): 用 Vite+ 替换 electron-vite"
	exit 1
fi
