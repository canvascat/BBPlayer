{
	"name": "@bbplayer/main",
	"version": "0.1.0",
	"private": true,
	"description": "BBPlayer Electron 主进程",
	"license": "AGPL-3.0-only",
	"author": "Roitium",
	"type": "module",
	"main": "dist/main.mjs",
	"exports": {
		"./router": {
			"types": "./src/trpc/router.ts"
		},
		"./preload": {
			"types": "./src/preload.ts"
		}
	},
	"scripts": {
		"build": "pnpm --filter @bbplayer/renderer build && vp pack --mode=production",
		"dev": "node ./scripts/dev.ts",
		"pack:mac": "pnpm build && electron-builder --mac --publish never",
		"release:mac": "pnpm build && electron-builder --mac --publish always",
		"start": "vp pack --mode=production && node ./scripts/start.ts",
		"test": "vp test"
	},
	"dependencies": {
		"@bbplayer/common": "workspace:*",
		"@bbplayer/core": "workspace:*",
		"@trpc/server": "^11.18.0",
		"electron-store": "11.0.2",
		"electron-updater": "6.8.9",
		"fractional-indexing": "4.0.0",
		"jszip": "3.10.1",
		"qrcode": "1.5.4",
		"rxjs": "^7.8.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^25.2.3",
		"@types/qrcode": "1.5.6",
		"electron": "43.4.1",
		"electron-builder": "26.15.3",
		"typescript": "~7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
		"vite-plus": "0.3.0"
	}
}
