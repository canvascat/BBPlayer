{
	"name": "@bbplayer/main",
	"version": "0.1.0",
	"private": true,
	"description": "BBPlayer Electron 主进程",
	"license": "AGPL-3.0-only",
	"author": "Roitium",
	"type": "module",
	"main": "dist/main.mjs",
	"exports": {
		"./router": "./src/trpc/router.ts",
		"./preload": "./src/preload.ts"
	},
	"scripts": {
		"build": "pnpm --filter @bbplayer/renderer build && vp pack --mode=production",
		"dev": "node ./scripts/dev.ts",
		"pack:mac": "pnpm build && electron-builder --mac --publish never",
		"release:mac": "pnpm build && electron-builder --mac --publish always",
		"start": "vp pack --mode=production && node ./scripts/start.ts",
		"test": "vp test"
	},
	"dependencies": {
		"@bbplayer/common": "workspace:*",
		"@bbplayer/core": "workspace:*",
		"@trpc/server": "^11.18.0",
		"electron-store": "10.1.0",
		"electron-updater": "6.6.2",
		"fractional-indexing": "4.0.0",
		"jszip": "3.10.1",
		"qrcode": "1.5.4",
		"rxjs": "^7.8.2",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^25.2.3",
		"@types/qrcode": "1.5.5",
		"electron": "37.2.6",
		"electron-builder": "26.0.12",
		"typescript": "~6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
		"vite-plus": "0.2.9"
	},
	"debug": {
		"env": {
			"VITE_DEV_SERVER_URL": "http://127.0.0.1:5173/"
		}
	}
}
