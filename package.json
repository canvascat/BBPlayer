{
	"name": "bbplayer-root",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "vp check",
		"check:deps": "syncpack list-mismatches",
		"desktop": "pnpm --filter @bbplayer/desktop dev",
		"fix:deps": "syncpack fix-mismatches",
		"format": "vp fmt --write .",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"prepare": "vp config --no-agent",
		"test": "vp test",
		"type-check": "tsgo --build --noEmit"
	},
	"devDependencies": {
		"@types/node": "^25.2.3",
		"@typescript/native-preview": "beta",
		"syncpack": "^13.0.4",
		"typescript": "~6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
		"vite-plus": "0.2.9"
	},
	"packageManager": "pnpm@10.32.1",
	"pnpm": {
		"peerDependencyRules": {
			"allowAny": [
				"vite"
			],
			"allowedVersions": {
				"vite": "*"
			},
			"ignoreMissing": [
				"@pixi/app",
				"@pixi/core",
				"@pixi/display",
				"@pixi/filter-blur",
				"@pixi/filter-bulge-pinch",
				"@pixi/filter-color-matrix",
				"@pixi/sprite",
				"electron-builder-squirrel-windows",
				"expo",
				"expo-sqlite",
				"react-native"
			]
		}
	}
}
